#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Ремонт.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Ремонт КАК Ремонт
		|УПОРЯДОЧИТЬ ПО
		|	Ремонт.Дата, Ремонт.Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоДокументов = 0;
	КоличествоСтрок = 0;
	
	Пока Выборка.Следующий() Цикл
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		ЕстьИзменения = Ложь;
		Для Каждого СтрокаТовара Из ДокументОбъект.Товары Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТовара.КлючСвязи) Тогда
				СтрокаТовара.КлючСвязи = Строка(Новый УникальныйИдентификатор);
				ЕстьИзменения = Истина;
				КоличествоСтрок = КоличествоСтрок + 1;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьИзменения Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
			КоличествоДокументов = КоличествоДокументов + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон(
		"Заполнено ключей связи: %1. Обработано документов: %2.",
		КоличествоСтрок, КоличествоДокументов);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти
