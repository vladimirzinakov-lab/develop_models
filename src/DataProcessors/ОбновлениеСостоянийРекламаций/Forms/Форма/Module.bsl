#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСостояния(Команда)
	
	Результат = ОбновитьСостоянияНаСервере();
	
	Если Результат.Обновлено = 0 И Результат.Пропущено = 0 Тогда
		ПоказатьОповещениеПользователя("Нет рекламаций, требующих изменения состояния");
	Иначе
		Текст = СтрШаблон("Обновлено документов: %1. Не удалось изменить: %2", Результат.Обновлено, Результат.Пропущено);
		ПоказатьОповещениеПользователя(Текст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ОбновитьСостоянияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Рекламация.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.Рекламация КАК Рекламация
		|ГДЕ
		|	НЕ Рекламация.ПометкаУдаления
		|	И Рекламация.Состояние <> ЗНАЧЕНИЕ(Перечисление.Рекл_СостоянияРекламации.Создана)
		|	И Рекламация.Состояние <> ЗНАЧЕНИЕ(Перечисление.Рекл_СостоянияРекламации.Закрыта)
		|	И Рекламация.Состояние <> ЗНАЧЕНИЕ(Перечисление.Рекл_СостоянияРекламации.ВРаботе)";
	
	Результат = Новый Структура;
	Результат.Вставить("Обновлено", 0);
	Результат.Вставить("Пропущено", 0);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Документ = Выборка.Ссылка.ПолучитьОбъект();
			Если Документ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Документ.Состояние = Перечисления.Рекл_СостоянияРекламации.ВРаботе;
			Документ.Записать();
			Результат.Обновлено = Результат.Обновлено + 1;
		Исключение
			Результат.Пропущено = Результат.Пропущено + 1;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Не удалось изменить состояние документа %1: %2", Выборка.Ссылка, ОписаниеОшибки());
			Сообщение.Сообщить();
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
